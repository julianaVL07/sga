### 4.15 RN-16 El folio de la reserva de 4.12 tiene el movimiento inverso del cargo de aseo ($110.000)
GET {{host}}/api/reservas/{{reservaConMascotas}}/folio
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("4.15 200 folio con el cargo de aseo revertido", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var cargos = response.body.cargos;
        var aseo = cargos.filter(function (c) { return c.concepto === "Cargo por aseo de mascota"; });
        var reversos = cargos.filter(function (c) {
            return c.concepto.indexOf("Reverso de 'Cargo por aseo de mascota'") === 0;
        });
        client.assert(aseo.length === 1 && aseo[0].valor === 110000, "Debía estar el cargo de aseo original de 4.12");
        client.assert(reversos.length === 1 && reversos[0].valor === -110000,
            "Debía estar el movimiento inverso de -110.000 (RN-16)");
        client.assert(reversos[0].concepto.indexOf("el grupo ya no trae mascotas") > 0,
            "El reverso debía indicar el motivo: " + reversos[0].concepto);
        client.assert(response.body.saldo === response.body.totalCargos - response.body.totalPagado,
            "El saldo debía ser cargos menos pagos");
    });
%}

