### Sección 12: FOLIO: CARGOS DE SERVICIOS ADICIONALES Y CORRECCIONES (7.1, L-17, RN-16)

# ====================================================================================================
# 12. Registrar cargos y correcciones en el folio (recepcionista)
#     Reserva propia de APT-201 de hoy+140 a hoy+142, que no choca con ninguna otra del archivo. En un folio
#     nuevo la posición 0 es el alojamiento y la 1 el depósito de garantía (RP-02); el cargo de la cena queda
#     en la posición 2 y su corrección en la 3. Corre con la app recién arrancada, sola o después del
#     recorrido completo.
# ====================================================================================================

### 12.0 Fechas de la sección
GET {{host}}/api/apartamentos
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("12.0 la app responde", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
    });
    var DIA = 86400000;
    var hoy = new Date(Date.now() - 5 * 3600000);
    function fecha(dias) {
        return new Date(hoy.getTime() + dias * DIA).toISOString().substring(0, 10);
    }
    client.global.set("cu12Entrada", fecha(140));
    client.global.set("cu12Salida", fecha(142));
%}

