### Sección 10: CU-26 y CU-27 LLEGADAS, SALIDAS Y CALENDARIO DE OCUPACIÓN (7.1, recepcionista)

# ====================================================================================================
# 10. CU-26 y CU-27 LLEGADAS, SALIDAS Y CALENDARIO DE OCUPACIÓN (7.1, recepcionista)
#     Solo consultan, así que corren igual con la app recién arrancada, solas o después del recorrido
#     completo. Usan datos iniciales que ninguna sección anterior cambia:
#       APT-102  CONFIRMADA hoy+12→hoy+15 (llegada prevista el día hoy+12)
#       APT-301  bloqueo hoy+20→hoy+25 por mantenimiento de la piscina de inmersión
#     El día hoy+2 siempre hay al menos una salida EN_CURSO: la de APT-201 de los datos iniciales o, si ya
#     corrió la sección 6 (que la cierra), la de APT-301 creada en 5.15.
# ====================================================================================================

### 10.0 Fechas propias de la sección
GET {{host}}/api/apartamentos
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.0 la app responde", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
    });
    var DIA = 86400000;
    var hoy = new Date(Date.now() - 5 * 3600000);
    function fecha(dias) {
        return new Date(hoy.getTime() + dias * DIA).toISOString().substring(0, 10);
    }
    client.global.set("cu26Hoy", fecha(0));
    client.global.set("cu26HoyMas2", fecha(2));
    client.global.set("cu26HoyMas5", fecha(5));
    client.global.set("cu26HoyMas10", fecha(10));
    client.global.set("cu26HoyMas12", fecha(12));
    client.global.set("cu26HoyMas17", fecha(17));
    client.global.set("cu26HoyMas19", fecha(19));
    client.global.set("cu26HoyMas26", fecha(26));
    client.global.set("cu26HoyMas63", fecha(63));
%}

### 10.1 CU-26 Llegadas de hoy (sin fecha: hoy en America/Bogota). Solo reservas CONFIRMADA que entran hoy
GET {{host}}/api/reservas/llegadas
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.1 200 llegadas de hoy", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        client.assert(response.body.tamano === 10, "El tamaño de página debía ser 10");
        var hoy = client.global.get("cu26Hoy");
        response.body.contenido.forEach(function (r) {
            client.assert(r.estado === "CONFIRMADA", r.codigo + " no está CONFIRMADA");
            client.assert(r.fechaEntrada === hoy, r.codigo + " no entra hoy");
        });
    });
%}

### 10.2 CU-26 Llegadas de hoy+12: aparece la CONFIRMADA de APT-102
GET {{host}}/api/reservas/llegadas?fecha={{cu26HoyMas12}}&pagina=0
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.2 200 llegada de APT-102", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var apt102 = response.body.contenido.filter(function (r) { return r.apartamento === "APT-102"; })[0];
        client.assert(apt102 != null, "Falta la llegada de APT-102");
        client.assert(apt102.estado === "CONFIRMADA", "La llegada debía estar CONFIRMADA");
        client.assert(apt102.fechaEntrada === client.global.get("cu26HoyMas12"), "Fecha de entrada inesperada");
    });
%}

