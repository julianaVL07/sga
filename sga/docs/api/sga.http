### 9.13 CU-23 Actualizar APT-401 y bajar la capacidad a 2: advierte la reserva de 3, que no se modifica (7.3)
PUT {{host}}/api/apartamentos/APT-401
Content-Type: application/json

{
  "nombre": "Coral Esmeralda Suite",
  "descripcion": "Remodelado como suite para parejas.",
  "dormitorios": 1,
  "capacidadMaxima": 2,
  "dotacion": ["Cama extragrande", "Cocina equipada", "Balcón con tina de hidromasaje"]
}

> {%
    client.test("9.13 200 actualizado con advertencia de capacidad", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        client.assert(response.body.apartamento.capacidadMaxima === 2, "La capacidad debía quedar en 2");
        client.assert(response.body.reservasSobreCapacidad.indexOf(client.global.get("codigoApt401")) >= 0,
            "Debía listar la reserva " + client.global.get("codigoApt401"));
        client.assert(response.body.advertencia.indexOf("7.3") === 0, "La advertencia debía citar 7.3");
    });
%}

