        client.assert(response.body.telefono === "3001000099", "Teléfono: " + response.body.telefono);
        client.assert(response.body.fotoUrl === "https://fotos.sga.local/recepcion-noche.png", "Foto: " + response.body.fotoUrl);
        client.assert(response.body.correo === "recepcion.noche@sga.local", "El correo no es editable: " + response.body.correo);
    });
%}

