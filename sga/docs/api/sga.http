# ====================================================================================================
# SGA - Apartahotel Coral. Recorrido completo de la API (entrega 2)
#
# Cómo ejecutarlo: arranque la app desde cero (./gradlew bootRun; H2 en memoria carga los datos iniciales)
# y en IntelliJ use "Run All Requests in File". Corre COMPLETO y en orden, sin preparar nada a mano:
#   - Las fechas se calculan en la petición 0.1 a partir de hoy en Colombia (UTC-5), igual que los datos
#     iniciales, que también son relativos a hoy.
#   - Los códigos de reserva se capturan de las respuestas (client.global.set) y se reutilizan con {{...}}.
#   - Cada petición valida su código HTTP con client.test; los 409 validan además el código de la regla.
# Si lo ejecuta dos veces sin reiniciar, fallan las que cambian estado (la reserva ya existe, etc.).
#
# Datos iniciales que se evitan (DatosInicialesCoralConfig y DatosInicialesReservasConfig):
#   APT-101  PENDIENTE hoy+10→hoy+12 (PORTAL), CANCELADA hoy+20→hoy+22, FINALIZADA hoy-10→hoy-7
#   APT-102  CONFIRMADA hoy+12→hoy+15, NO_SHOW hoy-5→hoy-3
#   APT-201  EN_CURSO hoy-1→hoy+2 (OCUPADO), PENDIENTE hoy+15→hoy+18 (EXTERNO, sin hora de llegada)
#   APT-202  FUERA_DE_SERVICIO con bloqueo hoy+3→hoy+15
#   APT-301  bloqueo hoy+20→hoy+25
# El flujo principal usa APT-301 de hoy a hoy+3, libre y PREPARADO al arrancar.
# ====================================================================================================

@host = http://localhost:8080

# ====================================================================================================
# 0. PREPARACIÓN
# ====================================================================================================

### 0.1 Calcular las fechas del recorrido (y comprobar que la app está arriba)
GET {{host}}/api/apartamentos

> {%
    client.test("0.1 la app responde", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
    });
    // Hoy en Colombia (America/Bogota, UTC-5 sin horario de verano), la misma zona del reloj del SGA.
    var DIA = 86400000;
    var hoy = new Date(Date.now() - 5 * 3600000);
    function fecha(dias) {
        return new Date(hoy.getTime() + dias * DIA).toISOString().substring(0, 10);
    }
    client.global.set("ayer", fecha(-1));
    client.global.set("hoy", fecha(0));
    client.global.set("hoyMas2", fecha(2));
    client.global.set("hoyMas3", fecha(3));
    client.global.set("hoyMas10", fecha(10));
    client.global.set("hoyMas12", fecha(12));
    client.global.set("hoyMas15", fecha(15));
    client.global.set("hoyMas20", fecha(20));
    client.global.set("hoyMas23", fecha(23));
    client.global.set("hoyMas30", fecha(30));
    client.global.set("hoyMas33", fecha(33));
    client.global.set("hoyMas40", fecha(40));
    client.global.set("hoyMas42", fecha(42));
    client.global.set("hoyMas43", fecha(43));
    client.global.set("hoyMas60", fecha(60));
    // RP-01: primer viernes en temporada Alta (10-dic-2026 al 20-ene-2027) a más de 25 días de hoy (fuera de
    // los datos iniciales). Una sola noche, de viernes a sábado.
    var viernes = new Date(Math.max(hoy.getTime() + 26 * DIA, Date.UTC(2026, 11, 10)));
    while (viernes.getUTCDay() !== 5) {
        viernes = new Date(viernes.getTime() + DIA);
    }
    client.global.set("viernesAlta", viernes.toISOString().substring(0, 10));
    client.global.set("sabadoAlta", new Date(viernes.getTime() + DIA).toISOString().substring(0, 10));
%}

