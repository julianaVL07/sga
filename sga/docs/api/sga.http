### 13.13 Sin token: 401 con el ErrorResponse del proyecto y WWW-Authenticate Bearer (7.5.6)
GET {{host}}/api/reservas?estado=PENDIENTE

> {%
    client.test("13.13 401 sin token con ErrorResponse", function () {
        client.assert(response.status === 401, "Se esperaba 401 y llegó " + response.status);
        client.assert(response.body.status === 401, "status: " + response.body.status);
        client.assert(response.body.error === "Unauthorized", "error: " + response.body.error);
        client.assert(response.body.mensaje === "Debe iniciar sesión o el token no es válido", response.body.mensaje);
        client.assert(response.body.path === "/api/reservas", "path: " + response.body.path);
        var www = response.headers.valueOf("WWW-Authenticate");
        client.assert(www != null && www.indexOf("Bearer") === 0, "WWW-Authenticate: " + www);
    });
%}

