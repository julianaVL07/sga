### 11.5 CU-29 Listar temporadas: Base (sin rangos), Media y Alta
GET {{host}}/api/temporadas
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("11.5 200 temporadas", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var ids = response.body.contenido.map(function (t) { return t.id; });
        ["T-BASE", "T-MEDIA", "T-ALTA"].forEach(function (id) {
            client.assert(ids.indexOf(id) >= 0, "Falta la temporada " + id);
        });
        var base = response.body.contenido.filter(function (t) { return t.id === "T-BASE"; })[0];
        client.assert(base.rangos.length === 0, "La temporada base no tiene rangos (F-05)");
    });
