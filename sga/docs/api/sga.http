### Sección 14: USUARIOS, PERFIL, CAMBIO DE CONTRASEÑA E HISTORIAL DEL HUÉSPED (Guía 12, 7.1 y 7.2)

# ====================================================================================================
# 14. USUARIOS. El administrador crea un recepcionista nuevo (recepcion.noche@sga.local), le cambia el rol y lo
#     desactiva al final; ese usuario edita su perfil y cambia su contraseña con su propio token.
#     El huésped 1 crea una reserva PORTAL a su nombre (APT-301, de hoy+160 a hoy+162) para que tenga una
#     reserva PENDIENTE: la del portal de los datos iniciales se canceló en 6.3.
# ====================================================================================================

### 14.0 Fechas de la sección
GET {{host}}/api/apartamentos
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("14.0 la app responde", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
    });
    var DIA = 86400000;
    var hoy = new Date(Date.now() - 5 * 3600000);
    function fecha(dias) {
        return new Date(hoy.getTime() + dias * DIA).toISOString().substring(0, 10);
    }
    client.global.set("cu14Entrada", fecha(160));
    client.global.set("cu14Salida", fecha(162));
%}

### 14.1 El administrador crea un recepcionista: 201 + Location, sin la contraseña en la respuesta
POST {{host}}/api/usuarios
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Recepcion Noche",
  "correo": "recepcion.noche@sga.local",
  "contrasena": "Noche2026",
  "telefono": "3001000010",
  "documento": "1000000010",
  "fechaNacimiento": "1994-02-11",
  "rol": "RECEPCIONISTA"
}

> {%
    client.test("14.1 201 usuario creado", function () {
        client.assert(response.status === 201, "Se esperaba 201 y llegó " + response.status);
        client.assert(response.body.rol === "RECEPCIONISTA", "Rol: " + response.body.rol);
        client.assert(response.body.activo === true, "Debía nacer activo");
        client.assert(response.body.contrasena === undefined, "La respuesta no debe traer la contraseña");
        var location = response.headers.valueOf("Location");
        client.assert(location != null && location.endsWith("/api/usuarios/" + response.body.id), "Location: " + location);
    });
    client.global.set("usuarioNuevoId", response.body.id);
    client.global.set("usuarioNuevoLocation", response.headers.valueOf("Location"));
%}

### 14.2 Consultar el usuario en la URL del Location
