### 10.5 CU-27 Calendario de APT-102 de hoy+10 a hoy+17: la CONFIRMADA ocupa hoy+12, hoy+13 y hoy+14
GET {{host}}/api/reservas/calendario?apartamento=APT-102&desde={{cu26HoyMas10}}&hasta={{cu26HoyMas17}}
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.5 200 calendario con reserva", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var noches = response.body.noches;
        client.assert(noches.length === 7, "Se esperaban 7 noches y llegaron " + noches.length);
        client.assert(noches[0].estado === "LIBRE", "hoy+10 debía estar LIBRE");
        [2, 3, 4].forEach(function (i) {
            client.assert(noches[i].estado === "RESERVADA", noches[i].fecha + " debía estar RESERVADA");
            client.assert(noches[i].estadoReserva === "CONFIRMADA", noches[i].fecha + " debía ser CONFIRMADA");
            client.assert(noches[i].codigoReserva.indexOf("RES-") === 0, "Falta el código de la reserva");
        });
        client.assert(noches[5].estado === "LIBRE", "La noche de salida (hoy+15) no se ocupa (3.1)");
    });
%}

### 10.6 CU-27 Calendario de APT-301 de hoy+19 a hoy+26: el bloqueo cubre de hoy+20 a hoy+24 (RN-07)
GET {{host}}/api/reservas/calendario?apartamento=APT-301&desde={{cu26HoyMas19}}&hasta={{cu26HoyMas26}}
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.6 200 calendario con bloqueo", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var noches = response.body.noches;
        client.assert(noches.length === 7, "Se esperaban 7 noches y llegaron " + noches.length);
        client.assert(noches[0].estado === "LIBRE", "hoy+19 debía estar LIBRE");
        [1, 2, 3, 4, 5].forEach(function (i) {
            client.assert(noches[i].estado === "BLOQUEADA", noches[i].fecha + " debía estar BLOQUEADA");
            client.assert(noches[i].motivoBloqueo === "Mantenimiento de la piscina de inmersión",
                "Motivo inesperado: " + noches[i].motivoBloqueo);
        });
        client.assert(noches[6].estado === "LIBRE", "hoy+25 ya no está bloqueado (fecha fin excluida)");
    });
%}

