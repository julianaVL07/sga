### 14.15 Canal por rol: el huésped 1 crea una reserva PORTAL a su nombre: 201
POST {{host}}/api/reservas
Authorization: Bearer {{tokenHuesped1}}
Content-Type: application/json

{
  "identificacionApartamento": "APT-301",
  "fechaEntrada": "{{cu14Entrada}}",
  "fechaSalida": "{{cu14Salida}}",
  "horaEstimadaLlegada": "16:00",
  "canalOrigen": "PORTAL",
  "titular": { "nombre": "Laura Gomez", "tipoDocumento": "CC", "numeroDocumento": "1094777888", "email": "huesped1@sga.local", "telefono": "3135550404" },
  "ocupantes": [ { "nombre": "Laura Gomez", "tipoDocumento": "CC", "numeroDocumento": "1094777888", "fechaNacimiento": "1995-01-30" } ]
}

> {%
    client.test("14.15 201 huésped crea PORTAL a su nombre", function () {
        client.assert(response.status === 201, "Se esperaba 201 y llegó " + response.status);
        client.assert(response.body.estado === "PENDIENTE", "La reserva nace PENDIENTE");
    });
    client.global.set("reservaHuesped1", response.body.codigo);
%}

### 14.16 Mis reservas del huésped 1: trae la de 14.15 y no la de Ana Gómez de 3.4
GET {{host}}/api/reservas/mias
Authorization: Bearer {{tokenHuesped1}}

> {%
    client.test("14.16 200 mis reservas del huésped 1", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var codigos = response.body.contenido.map(function (r) { return r.codigo; });
        client.assert(codigos.indexOf(client.global.get("reservaHuesped1")) >= 0, "Faltó la reserva de 14.15");
        client.assert(codigos.indexOf(client.global.get("codigo")) < 0, "Trajo una reserva ajena (3.4)");
    });
%}

### 14.17 Mis reservas del huésped 2: no trae la reserva del huésped 1
GET {{host}}/api/reservas/mias
Authorization: Bearer {{tokenHuesped2}}

> {%
    client.test("14.17 200 mis reservas del huésped 2", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        var codigos = response.body.contenido.map(function (r) { return r.codigo; });
        client.assert(codigos.indexOf(client.global.get("reservaHuesped1")) < 0, "Trajo la reserva del huésped 1");
    });
%}

