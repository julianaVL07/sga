### 5.28 RN-19 Una reserva EXTERNO no entra por POST /api/reservas, sino por el canal (CU-08): 403
# Desde la Guía 12 el canal por rol (CanalPorRolVerificador) no deja crear por EXTERNO a ningún rol, así que la
# petición se corta con 403 antes de llegar al dominio. RN-19 sigue en el dominio y en sus pruebas unitarias.
POST {{host}}/api/reservas
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "identificacionApartamento": "APT-102",
  "fechaEntrada": "{{hoyMas40}}",
  "fechaSalida": "{{hoyMas43}}",
  "horaEstimadaLlegada": "16:00",
  "canalOrigen": "EXTERNO",
  "titular": { "nombre": "Ana Gómez", "tipoDocumento": "CC", "numeroDocumento": "1094200300", "email": "ana.gomez@correo.co", "telefono": "3005550101" },
  "ocupantes": [ { "nombre": "Ana Gómez", "fechaNacimiento": "1990-05-20" } ]
}

> {%
    client.test("5.28 403 EXTERNO no entra por POST /api/reservas", function () {
        client.assert(response.status === 403, "Se esperaba 403 y llegó " + response.status);
        client.assert(response.body.mensaje === "No tiene permiso para realizar esta operación", response.body.mensaje);
    });
%}

