### Sección 9: CU-22 a CU-25 ADMINISTRACIÓN DE APARTAMENTOS Y TARIFAS (7.3, 7.4)

# ====================================================================================================
# 9. CU-22 a CU-25: registrar, definir tarifas (con histórico), activar y actualizar un apartamento
#    Flujo con APT-401, que no existe en los datos iniciales: crear (inactivo) → tarifas → activar →
#    buscar → reservar 3 ocupantes → bajar la capacidad a 2 (advierte la reserva) → histórico.
#    Usa APT-202, retirado de la venta en 2.3, para los casos del apartamento eliminado.
# ====================================================================================================

### 9.0 Fechas propias de la sección: la reserva de APT-401 va de hoy+60 a hoy+63
GET {{host}}/api/apartamentos
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("9.0 la app responde", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
    });
    var DIA = 86400000;
    var hoy = new Date(Date.now() - 5 * 3600000);
    function fecha(dias) {
        return new Date(hoy.getTime() + dias * DIA).toISOString().substring(0, 10);
    }
    client.global.set("cu22Hoy", fecha(0));
    client.global.set("cu22Entrada", fecha(60));
    client.global.set("cu22Salida", fecha(63));
%}

### 9.1 CU-22 Registrar APT-401 con tarifa solo en temporada Base: 201 + Location, nace INACTIVO
POST {{host}}/api/apartamentos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "identificacion": "APT-401",
  "nombre": "Coral Esmeralda",
  "descripcion": "Unidad nueva con vista a la bahía, pensada para familias pequeñas.",
  "dormitorios": 2,
  "capacidadMaxima": 4,
  "dotacion": ["Cama extragrande", "Dormitorio con dos camas sencillas", "Cocina equipada", "Balcón con vista a la bahía"],
  "imagenes": [
    { "url": "https://coral.co/img/apt-401-sala.jpg", "principal": true },
    { "url": "https://coral.co/img/apt-401-balcon.jpg", "principal": false }
  ],
  "tarifas": [
    { "idTemporada": "T-BASE", "valorPorOcupante": 300000 }
  ]
}

> {%
    client.test("9.1 201 apartamento registrado e inactivo", function () {
        client.assert(response.status === 201, "Se esperaba 201 y llegó " + response.status);
        client.assert(response.headers.valueOf("Location") != null, "Falta la cabecera Location");
        client.assert(response.body.activo === false, "El apartamento nuevo debe nacer inactivo (7.4)");
        client.assert(response.body.estadoOperativo === "PREPARADO", "El apartamento nuevo nace PREPARADO");
    });
    client.global.set("locationApt401", response.headers.valueOf("Location"));
%}

