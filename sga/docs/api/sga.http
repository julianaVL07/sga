### Sección 5: UN 409 POR CADA REGLA DE NEGOCIO QUE EXPONE LA API

# ====================================================================================================
# 5. UN 409 POR CADA REGLA DE NEGOCIO QUE EXPONE LA API
#    El nombre de cada petición lleva el código de la regla; el mensaje de la respuesta empieza por él.
# ====================================================================================================

### 5.1 RN-01 Solapamiento: APT-102 ya tiene una reserva CONFIRMADA de hoy+12 a hoy+15
POST {{host}}/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "APT-102",
  "fechaEntrada": "{{hoyMas12}}",
  "fechaSalida": "{{hoyMas15}}",
  "horaEstimadaLlegada": "16:00",
  "canalOrigen": "PORTAL",
  "titular": { "nombre": "Ana Gómez", "tipoDocumento": "CC", "numeroDocumento": "1094200300", "email": "ana.gomez@correo.co", "telefono": "3005550101" },
  "ocupantes": [ { "nombre": "Ana Gómez", "fechaNacimiento": "1990-05-20" } ]
}

> {%
    client.test("5.1 409 RN-01", function () {
        client.assert(response.status === 409, "Se esperaba 409 y llegó " + response.status);
        client.assert(response.body.mensaje.startsWith("RN-01"), "Mensaje inesperado: " + response.body.mensaje);
    });
%}

