### 3.4 CU-03 Crear la reserva: 201 + Location
POST {{host}}/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "APT-301",
  "fechaEntrada": "{{hoy}}",
  "fechaSalida": "{{hoyMas3}}",
  "horaEstimadaLlegada": "16:00",
  "canalOrigen": "PORTAL",
  "titular": {
    "nombre": "Ana Gómez",
    "tipoDocumento": "CC",
    "numeroDocumento": "1094200300",
    "email": "ana.gomez@correo.co",
    "telefono": "3005550101"
  },
  "ocupantes": [
    { "nombre": "Ana Gómez", "tipoDocumento": "CC", "numeroDocumento": "1094200300", "fechaNacimiento": "1990-05-20" },
    { "nombre": "Sofía Gómez", "fechaNacimiento": "2021-03-02" }
  ]
}

> {%
    client.test("3.4 201 reserva creada con Location", function () {
        client.assert(response.status === 201, "Se esperaba 201 y llegó " + response.status);
        client.assert(response.body.estado === "PENDIENTE", "La reserva nace PENDIENTE");
        client.assert(response.headers.valueOf("Location") != null, "Falta la cabecera Location");
    });
    client.global.set("codigo", response.body.codigo);
    client.global.set("valorTotal", response.body.valorTotal);
    client.global.set("location", response.headers.valueOf("Location"));
%}

