### Sección 7: ERRORES 400: el mensaje está mal escrito (validación del DTO, fechas y enums)

# ====================================================================================================
# 7. ERRORES 400: el mensaje está mal escrito (validación del DTO, fechas y enums)
# ====================================================================================================

### 7.1 400 Validación del DTO: faltan las fechas y el email no es válido (cuerpo con "errores" por campo)
POST {{host}}/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "APT-102",
  "canalOrigen": "PORTAL",
  "titular": { "nombre": "Ana Gómez", "tipoDocumento": "CC", "numeroDocumento": "1094200300", "email": "no-es-un-correo", "telefono": "3005550101" },
  "ocupantes": [ { "nombre": "Ana Gómez", "fechaNacimiento": "1990-05-20" } ]
}

> {%
    client.test("7.1 400 validación", function () {
        client.assert(response.status === 400, "Se esperaba 400 y llegó " + response.status);
    });
