### 9.15 CU-24 Histórico de tarifas: de la más reciente a la más antigua; la Base anterior quedó cerrada hoy
GET {{host}}/api/apartamentos/APT-401/tarifas/historico?pagina=0

> {%
    client.test("9.15 200 histórico conserva la tarifa anterior", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        client.assert(response.body.totalElementos === 4, "Se esperaban 4 registros y llegaron " + response.body.totalElementos);
        var anterior = response.body.contenido.filter(function (r) { return r.valorPorOcupante === 300000; })[0];
        client.assert(anterior != null, "Falta la tarifa Base anterior de 300.000");
        client.assert(anterior.vigente === false, "La tarifa anterior ya no está vigente");
        client.assert(anterior.vigenteDesde === client.global.get("cu22Hoy"), "vigenteDesde debía ser hoy");
        client.assert(anterior.vigenteHasta === client.global.get("cu22Hoy"), "vigenteHasta debía ser hoy");
        client.assert(response.body.contenido[response.body.contenido.length - 1].valorPorOcupante === 300000,
            "La más antigua va de última");
    });
%}

