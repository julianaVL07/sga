### 11.2 CU-28 Actualizar datos, ubicación y normas (el horario se envía igual: 15:00 y 11:00)
PUT {{host}}/api/alojamiento
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Coral",
  "descripcion": "Conjunto residencial de apartamentos independientes de alta gama frente al mar Caribe.",
  "ciudad": "Cartagena de Indias",
  "direccion": "Sector Bocagrande, Avenida del Malecón, frente a las playas de Castillo Grande",
  "latitud": 10.3975,
  "longitud": -75.559,
  "normaConvivencia": "Silencio estricto en balcones entre las 23:00 y las 07:00; prohibido fumar dentro de los apartamentos; mascotas siempre con correa en las áreas comunes.",
  "horaEntrada": "15:00",
  "horaSalida": "11:00"
}

> {%
