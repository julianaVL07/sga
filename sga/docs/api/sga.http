### 4.10 7.1 Pendientes de preparación: APT-301 quedó PENDIENTE_PREPARACION tras la salida de 3.11
GET {{host}}/api/apartamentos/pendientes-preparacion
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("4.10 200 pendientes de preparación", function () {
        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        client.assert(response.body.tamano === 10, "El tamaño de página debía ser 10");
        var ids = response.body.contenido.map(function (a) { return a.identificacion; });
        client.assert(ids.indexOf("APT-301") >= 0, "APT-301 debía estar por preparar: " + ids);
        client.assert(ids.indexOf("APT-202") < 0, "APT-202 fue retirado en 2.3 y no debía aparecer");
        client.assert(response.body.contenido.every(function (a) {
            return a.estadoOperativo === "PENDIENTE_PREPARACION" || a.estadoOperativo === "EN_PREPARACION";
        }), "Solo debían salir apartamentos en PENDIENTE_PREPARACION o EN_PREPARACION");
    });
%}

