### 12.2 7.1 Registrar el cargo de la cena en el balcón (L-17): 201 con Location al folio
POST {{host}}/api/reservas/{{cu12Codigo}}/folio/cargos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "idServicio": "SRV-CENA-BALCON" }

> {%
    client.test("12.2 201 cargo de servicio adicional", function () {
        client.assert(response.status === 201, "Se esperaba 201 y llegó " + response.status);
        var location = response.headers.valueOf("Location");
        client.assert(location != null && location.indexOf("/api/reservas/" + client.global.get("cu12Codigo") + "/folio") >= 0,
            "Location debía apuntar al folio: " + location);
        client.assert(response.body.cargos.length === 3, "Se esperaban 3 cargos (alojamiento, depósito y cena)");
        client.assert(response.body.cargos[2].tipo === "SERVICIO_ADICIONAL", "El cargo debía ser SERVICIO_ADICIONAL");
        client.assert(response.body.cargos[2].valor === 260000, "La cena vale 260.000");
    });
    client.global.set("cu12SaldoConCena", response.body.saldo);
%}

