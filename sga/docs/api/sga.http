### 12.5 RN-16 Corregir el cargo de la cena (posición 2): movimiento inverso, 201 con Location al folio
POST {{host}}/api/reservas/{{cu12Codigo}}/folio/correcciones
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "indiceCargo": 2, "motivo": "La cena no se consumió" }

> {%
    client.test("12.5 201 corrección por movimiento inverso", function () {
        client.assert(response.status === 201, "Se esperaba 201 y llegó " + response.status);
        client.assert(response.headers.valueOf("Location") != null, "Falta la cabecera Location");
        client.assert(response.body.cargos.length === 4, "Se esperaban 4 cargos");
        client.assert(response.body.cargos[2].valor === 260000, "El cargo original no se edita (RN-16)");
        client.assert(response.body.cargos[3].valor === -260000, "La corrección debía ser -260.000");
        client.assert(response.body.saldo === client.global.get("cu12SaldoConCena") - 260000,
            "El saldo debía bajar 260.000");
    });
%}

