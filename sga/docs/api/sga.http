        client.assert(response.status === 200, "Se esperaba 200 y llegó " + response.status);
        client.assert(response.body.normaConvivencia.indexOf("mascotas siempre con correa") > 0,
            "No se actualizaron las normas");
        client.assert(response.body.horaEntrada.indexOf("15:00") === 0, "El horario debía seguir en 15:00");
        client.assert(response.body.parametros.porcentajeAnticipo === 50, "Los parámetros no cambian por API");
    });
%}

