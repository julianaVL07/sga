# Copie este archivo como application-secrets.properties en la misma carpeta.
# Ese archivo NO se versiona (.gitignore). Minimo 32 caracteres (256 bits) para HS256.
sga.jwt.secret=reemplace-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Clave de Google AI Studio para el modelo de IA (solo se usa con sga.ia.proveedor=gemini).
# Sin una clave valida Gemini no sugiere nada y lo registra en el log. Ver la seccion "Modelo de IA" del README.
sga.ia.gemini.clave=reemplace-por-su-clave-de-google-ai-studio

# Cuenta y clave de aplicacion de Gmail para los correos al titular (solo se usan con sga.notificaciones.proveedor=smtp).
# La clave es la "contrasena de aplicacion" de 16 letras, no la contrasena de la cuenta. Ver la seccion
# "Notificaciones" del README.
sga.notificaciones.smtp.usuario=reemplace-por-su-cuenta@gmail.com
sga.notificaciones.smtp.clave=reemplace-por-su-clave-de-aplicacion

# Credencial del canal externo "booking" de los datos iniciales (encabezado X-Canal-Credencial). Es la misma que
# va en la variable @credencial de docs/api/canal-externo.http. Si no se escribe, la app genera una al arrancar y
# la muestra en el log. Ver la seccion "Canal externo" del README.
sga.canales.credencial-demo=reemplace-por-una-credencial-larga-y-aleatoria
